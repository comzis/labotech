# ── Server ─────────────────────────────────────────
API_HOST=10.67.18.29
API_PORT=4000
NODE_ENV=production

# ── Network interfaces ──────────────────────────────
MANAGEMENT_NIC=eno1
MULTICAST_NIC=eno2

# ── Multicast forward subnet ────────────────────────
FORWARD_MULTICAST_SUBNET=239.100.25.0/26
FORWARD_MULTICAST_IP=239.100.25.29
MULTICAST_TTL=10
RESTORE_STREAMS_ON_BOOT=false
RESTORE_TRANSCODERS_ON_BOOT=false
RESTORE_FORWARDERS_ON_BOOT=false
MAX_ACTIVE_FORWARDERS=1

# ── SRT output defaults ─────────────────────────────
SRT_HOST=your.destination.server.com
SRT_PORT=9999
SRT_LATENCY=2000
SRT_PASSPHRASE=change_this_in_production

# ── Encoding defaults ───────────────────────────────
VIDEO_BITRATE=8M
AUDIO_BITRATE=256k
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# ── Monitoring ──────────────────────────────────────
SNMP_MANAGER_HOST=10.67.18.1
SYSLOG_HOST=10.67.18.1
SYSLOG_PORT=514
THUMBNAIL_INTERVAL_SEC=5
THUMBNAIL_QUALITY_PROFILE=high

# ── Dolby E external decoder adapter (optional) ─────
DOLBYE_ENABLED=false
DOLBYE_DECODER_PATH=
# Prefer JSON array args for exact tokenization, e.g. ["--input","{url}","--json"]
DOLBYE_DECODER_ARGS_JSON=
# Fallback text args template (used when *_JSON is empty)
DOLBYE_DECODER_ARGS=--input {url} --json
DOLBYE_DECODER_TIMEOUT_MS=4000
# Strict mode: penalise health score when Dolby E is detected but decoder is unavailable
DOLBYE_REQUIRED_WHEN_DETECTED=false
# Health penalty overrides (default values shown)
TS_HEALTH_DOLBYE_MISSING_PENALTY=10
TS_HEALTH_DOLBYE_DECODE_FAIL_PENALTY=18
