# ── UI login credentials (Vite build-time, never commit real values) ──────
# VITE_ prefix exposes these to the frontend bundle — use strong passwords.
VITE_ADMIN_PASS=change_this_in_production
VITE_OPS_PASS=change_this_in_production

# ── Server ─────────────────────────────────────────
API_HOST=<your-management-nic-ip>
API_PORT=4000
NODE_ENV=production

# ── Network interfaces ──────────────────────────────
MANAGEMENT_NIC=eno1
MULTICAST_NIC=eno2
# Management NIC IP address — used to bind SRT caller sockets to the correct interface.
# Set to your management NIC IP (e.g. 192.168.1.10). Default 0.0.0.0 lets the OS choose.
MANAGEMENT_IP=0.0.0.0

# ── Multicast forward subnet ────────────────────────
FORWARD_MULTICAST_SUBNET=239.100.25.0/26
FORWARD_MULTICAST_IP=239.100.25.29
MULTICAST_TTL=10
RESTORE_STREAMS_ON_BOOT=false
RESTORE_TRANSCODERS_ON_BOOT=false
RESTORE_FORWARDERS_ON_BOOT=false
MAX_ACTIVE_FORWARDERS=1

# ── SRT output defaults ─────────────────────────────
SRT_HOST=your.destination.server.com
SRT_PORT=9999
SRT_LATENCY=2000
SRT_PASSPHRASE=change_this_in_production

# ── Encoding defaults ───────────────────────────────
VIDEO_BITRATE=8M
AUDIO_BITRATE=256k
VIDEO_CODEC=libx264
AUDIO_CODEC=aac

# ── Monitoring ──────────────────────────────────────
SNMP_MANAGER_HOST=<your-snmp-manager-ip>
SYSLOG_HOST=<your-syslog-server-ip>
SYSLOG_PORT=514
THUMBNAIL_INTERVAL_SEC=5
THUMBNAIL_QUALITY_PROFILE=high
# Target thumbnail frame rate (default 5, max 25).
# Increase to 10 for faster refresh on a powerful server (Xeon Gold etc).
THUMBNAIL_FPS=5
# Capture from I-frames only (default true) — clean artefact-free images.
# Set to false for near-live refresh at THUMBNAIL_FPS regardless of GOP size.
# Trade-off: true = clean image, rate limited by GOP; false = fast, may show B/P artefacts.
THUMBNAIL_KEYFRAME_ONLY=true

# ── Dolby E external decoder adapter (optional) ─────
DOLBYE_ENABLED=false
DOLBYE_DECODER_PATH=
# Prefer JSON array args for exact tokenization, e.g. ["--input","{url}","--json"]
DOLBYE_DECODER_ARGS_JSON=
# Fallback text args template (used when *_JSON is empty)
DOLBYE_DECODER_ARGS=--input {url} --json
DOLBYE_DECODER_TIMEOUT_MS=4000
# Strict mode: penalise health score when Dolby E is detected but decoder is unavailable
DOLBYE_REQUIRED_WHEN_DETECTED=false
# Health penalty overrides (default values shown)
TS_HEALTH_DOLBYE_MISSING_PENALTY=10
TS_HEALTH_DOLBYE_DECODE_FAIL_PENALTY=18

# ── Release/build metadata (optional) ─────────────────
# Authoritative release string surfaced in API/UI health payloads.
LABOTECH_RELEASE=

# ── Monitoring and probe tuning (advanced/optional) ───
# Policy profile key from config/monitoring-policy.json.
MONITORING_POLICY_PROFILE=broadcast-balanced-v1
# Heavy probe scheduler (ts-analyser).
TS_HEAVY_PROBE_MAX_CONCURRENT=3
TSDUCK_MONITOR_INTERVAL_MS=10000
# Live input demux tuning (used by analyser/forwarder thumbnail and probe paths).
TS_INPUT_FIFO_SIZE=524288
TS_INPUT_TIMEOUT_US=7000000
TS_INPUT_REORDER_QUEUE_SIZE=256
# Thumbnail worker/process limits.
THUMBNAIL_MAX_CONCURRENT=2

# ── ETR290 behavior (advanced/optional) ───────────────
ETR290_ENGINE=tsduck
ETR290_STARTUP_GRACE_MS=5000
ETR290_INCIDENT_CLEAR_GRACE_MS=12000
ETR290_PENDING_BURST_WINDOW_MS=30000
ETR_ORPHAN_GRACE_MS=15000
ETR_ORPHAN_CHECK_MS=5000

# ── Encapsulator API/process controls (advanced) ──────
ENCAPSULATOR_HOST=127.0.0.1
ENCAPSULATOR_PORT=4100
ENCAPSULATOR_CPUS=
ENCAPSULATOR_CPUSET=

# Guardrail controls for encapsulator scheduling.
ENCAP_CPU_GUARDRAIL_ENABLED=true
ENCAP_CPU_WARN_PCT=70
ENCAP_CPU_BLOCK_PCT=85
ENCAP_CAPACITY_PER_CORE=4
ENCAP_CAPACITY_STREAM_MBPS=15

# Admin kill endpoint controls.
ENCAP_KILL_ENABLED=true
ENCAP_KILL_FORCE_ANY=false
ENCAP_KILL_ALLOWLIST=encapsulator,boro,dashboard

# ── Forwarding enforcement (advanced/optional) ────────
FORWARD_REQUIRE_EXPLICIT_DEST=true
FORWARD_IP_BIN=ip

# ── Event log retention/tuning (advanced/optional) ────
EVENT_LOG_RING_SIZE=500
EVENT_LOG_RETENTION_DAYS=14
EVENT_LOG_CLEANUP_INTERVAL_MS=21600000
