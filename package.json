{
  "name": "labotech",
  "version": "2.0.0",
  "description": "Professional broadcast encoder and stream management",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "test-exclude": "^8.0.0",
    "glob": "^13.0.6"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/",
      "<rootDir>/node_modules/"
    ]
  }
}
