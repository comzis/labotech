# Frontend auth credentials (build-time; exposed to browser bundle)
VITE_ADMIN_PASS=change_this_in_production
VITE_OPS_PASS=change_this_in_production

# Frontend release metadata (build-time)
# VITE_APP_VERSION is typically read from web/package.json by CI/build tooling.
VITE_APP_VERSION=3.1.129
# Optional explicit release override shown in UI.
VITE_RELEASE_VERSION=v3.2.25
# Optional UTC build timestamp string.
VITE_BUILD_TIME_UTC=2026-04-08T00:00:00Z

# UI thumbnail refresh interval in milliseconds.
VITE_THUMB_INTERVAL_MS=5000
